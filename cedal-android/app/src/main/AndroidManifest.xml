<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- ARC > Labs reads the phone's own Wi-Fi IP/subnet so its network
         scanner knows which local addresses to sweep - both are "normal"
         protection-level permissions (no runtime prompt needed). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Lets Code > Kotlin trigger the system "install this app?" dialog for
         a build it just downloaded. The user still has to grant "Install
         unknown apps" for Cedal once via system settings before the dialog
         will actually appear - this permission alone doesn't skip that. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets Code > Kotlin notify when a long build finishes, even if the
         user has left the Code screen. Android 13+ requires this be
         requested at runtime too - see MemberCodeScreen's permission launcher. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- ✚ > Search's "from your contacts" prompt - see MemberSearchScreen's
         SearchTabBody and FriendService.matchContacts server-side. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Chat's camera attachment (photo/video capture) - see
         MemberChatThreadScreen's AttachmentMenuOverlay. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Chat's voice-note mic button - see ChatInputBar's press-and-hold. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Settings > AI > "Call Out (Screen Capture)" - a single on-demand
         screenshot handed to Corneal for real vision. Android 14+ requires a
         foreground service of type mediaProjection to actually capture (see
         CallOutCaptureService), which itself requires these two. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:name=".CedalApplication"
        android:allowBackup="true"
        android:label="Cedal"
        android:theme="@style/Theme.Cedal"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Cedal"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Code area GitHub sync OAuth return trip - see
                 MainActivity.onNewIntent / routes/PlatformRoutes.kt's
                 codeSyncCallbackHtml server-side. singleTask above is what
                 lets this land in the already-running app via onNewIntent
                 instead of spawning a second MainActivity instance. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cedalcode-oauth" android:host="github-callback" />
            </intent-filter>
            <!-- Group Profile's "LINK" tab (Round 5) - scanning/opening a
                 group's QR/invite link lands here, same singleTask/
                 onNewIntent pattern as the GitHub OAuth callback above. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cedalcode" android:host="group" />
            </intent-filter>
        </activity>

        <!-- Lets Code > Pad hand an .html file's content to the user's
             actual default browser (ACTION_VIEW) — modern Android blocks
             raw file:// URIs shared with other apps, so this mints a
             content:// URI scoped to just that one file instead. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Settings > AI > "Call Out (Screen Capture)" - see
             CallOutCaptureService's own doc comment. -->
        <service
            android:name=".CallOutCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Real push notifications (2026-08-13) - see CedalMessagingService's
             own doc comment for why this app needed this at all. -->
        <service
            android:name=".CedalMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>
</manifest>
