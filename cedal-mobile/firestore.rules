rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---- users ----
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      // vipExp is spent/granted only server-side (billing.ts, requestAndroidBuild.ts
      // via the admin SDK, which bypasses these rules) - never client-writable.
      allow update: if isOwner(uid)
        && request.resource.data.vipExp == resource.data.vipExp;
      allow delete: if false;

      match /private/{doc} {
        allow read, write: if isOwner(uid);
      }
      match /groups/{groupId} {
        allow read, write: if isOwner(uid);
      }
      match /hackSessions/{doc} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---- wallet transactions ----
    // Also written server-side (billing.ts) via the admin SDK, which bypasses
    // these rules entirely. Client-created transactions are immutable once made.
    match /walletTransactions/{id} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- Android APK builds ----
    // Created and updated only server-side (requestAndroidBuild.ts / android-builder
    // via the admin SDK). Client only ever reads its own build's status.
    match /androidBuilds/{jobId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // ---- app config ----
    // Public read (the update-gate check runs before login too); server-only write.
    match /appConfig/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // ---- chat rooms / DMs ----
    match /rooms/{chatId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow delete: if false;

      match /messages/{msgId} {
        allow read, write: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(chatId)).data.participants;
      }
      match /typing/{doc} {
        allow read, write: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/rooms/$(chatId)).data.participants;
      }
    }

    // ---- groups ----
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      // join/leave via members arrayUnion/arrayRemove, invite-code redemption, etc. -
      // just protect ownership from being hijacked by an update.
      allow update: if isSignedIn() && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /messages/{msgId} {
        allow read, write: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }
    }

    // ---- friend requests ----
    match /friendRequests/{id} {
      allow read: if isSignedIn()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && (resource.data.fromId == request.auth.uid || resource.data.toId == request.auth.uid);
    }

    // ---- stickers ----
    match /stickers/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ---- trades ----
    match /trades/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ---- user-submitted chat reports ----
    match /reports/{chatId}/items/{id} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false; // moderation-only
    }
    // Separate top-level moderation reports written only by alexReport.ts (admin SDK).
    match /reports/{id} {
      allow read, write: if false;
    }

    // ---- games & notifications ----
    // No per-user ownership in the app's current data model (shared/global feature) -
    // rules can only be as strict as the app's own design; flagged for future hardening.
    match /games/{id} {
      allow read, write: if isSignedIn();
    }
    match /notifications/{id} {
      allow read, write: if isSignedIn();
    }

    // Deny everything not explicitly matched above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
