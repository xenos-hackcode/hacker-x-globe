{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "components/ui/collapsible.js",
    "app/modal.js",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "app/index.js",
    "src/components/chat/ChatListHeader.tsx"
  ]
}
